fla=lira_ramp(mtof(pow(lfo1/127,2)*127-75),23.22);
flb=lira_ramp(mtof(pow(lfo2/127,2)*127-75),23.22);
ls1=clamp(cos(lphase1*6.28318530718)*1000,-1,1);
ls2=clamp(cos(lphase2*6.28318530718)*1000,-1,1);
