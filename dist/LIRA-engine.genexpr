src2=((routing>0?0.001:1)*p1+(routing>0?1:0.001)*p1)*(source2==0?1:0.001)+(lmod*(totalfb>0?0.001:1)+tf*(totalfb>0?1:0.001))*(source2==2?1:0.001);
md2=lira_ramp(pow(mod2/127,4)*2,23.22); sh2=lira_ramp(pow(sharp2/127,2),23.22);
vib2=cycle(2.31)*lira_ramp(vibrato,23.22);
src3=((routing>0?0.001:1)*p4+(routing>0?1:0.001)*p2)*(source3==0?1:0.001)+(lmod*(totalfb>0?0.001:1)+tf*(totalfb>0?1:0.001))*(source3==2?1:0.001);
md3=lira_ramp(pow(mod3/127,4)*2,23.22); sh3=lira_ramp(pow(sharp3/127,2),23.22);
vib3=cycle(3.17)*lira_ramp(vibrato,23.22);
src4=((routing>0?0.001:1)*p3+(routing>0?1:0.001)*p3)*(source4==0?1:0.001)+(lmod*(totalfb>0?0.001:1)+tf*(totalfb>0?1:0.001))*(source4==2?1:0.001);
md4=lira_ramp(pow(mod4/127,4)*2,23.22); sh4=lira_ramp(pow(sharp4/127,2),23.22);
vib4=cycle(1.79)*lira_ramp(vibrato,23.22);
raw1=mtof(-16+tune1/127*109)*(0.01+1.99*pitch1/127);
fq1=lira_ramp(quantize>0?mtof(floor(ftom(raw1)+0.5)):raw1,23.22);
v1=lira_voice(fq1*pow(2,lira_ramp(bend1,5)/12)*(1+vib1*0.005)*(1+src1*md1),clamp(sh1+lira_ramp(press1,10)*0.6,0,1),max(gate1,voiceon1),lira_ramp(pow(hold1/127,2),23.22),fast1,0.53125+vib1*0.025);
raw2=mtof(-16+tune2/127*109)*(0.01+1.99*pitch1/127);
