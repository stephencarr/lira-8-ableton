v8=lira_voice(fq8*pow(2,lira_ramp(bend8,5)/12)*(1+vib4*0.005)*(1+src4*md4),clamp(sh4+lira_ramp(press8,10)*0.6,0,1),max(gate8,voiceon8),lira_ramp(pow(hold2/127,2),23.22),fast4,0.53125+vib4*0.025);
hpf_0_a = clamp(1 - 6.28318530718 * (3) / samplerate, 0, 1); hpf_0_input = v1+v2; hpf_0_out = (1+hpf_0_a)*0.5*(hpf_0_input-hpf_0_x)+hpf_0_a*hpf_0_y; hpf_0_x=hpf_0_input; hpf_0_y=hpf_0_out;
pair1.write(hpf_0_out);
hpf_1_a = clamp(1 - 6.28318530718 * (3) / samplerate, 0, 1); hpf_1_input = v3+v4; hpf_1_out = (1+hpf_1_a)*0.5*(hpf_1_input-hpf_1_x)+hpf_1_a*hpf_1_y; hpf_1_x=hpf_1_input; hpf_1_y=hpf_1_out;
pair2.write(hpf_1_out);
hpf_2_a = clamp(1 - 6.28318530718 * (3) / samplerate, 0, 1); hpf_2_input = v5+v6; hpf_2_out = (1+hpf_2_a)*0.5*(hpf_2_input-hpf_2_x)+hpf_2_a*hpf_2_y; hpf_2_x=hpf_2_input; hpf_2_y=hpf_2_out;
pair3.write(hpf_2_out);
hpf_3_a = clamp(1 - 6.28318530718 * (3) / samplerate, 0, 1); hpf_3_input = v7+v8; hpf_3_out = (1+hpf_3_a)*0.5*(hpf_3_input-hpf_3_x)+hpf_3_a*hpf_3_y; hpf_3_x=hpf_3_input; hpf_3_y=hpf_3_out;
pair4.write(hpf_3_out);

dry=(v1*lira_ramp(level1/127,23.22)+v2*lira_ramp(level2/127,23.22)+v3*lira_ramp(level3/127,23.22)+v4*lira_ramp(level4/127,23.22)+v5*lira_ramp(level5/127,23.22)+v6*lira_ramp(level6/127,23.22)+v7*lira_ramp(level7/127,23.22)+v8*lira_ramp(level8/127,23.22))*0.166667;
dry=dry+(in1+in2)*0.5*lira_ramp(extgain/127*extready,23.22);
fb=lira_ramp(feedback/127*pow(2,2*feedback/127),23.22);
dlfo=(dwave>0?lsqr:ltri)*(dsource==2);
self1=lira_lp(delay1.read(64)*0.5*(dsource==0),689);
self2=lira_lp(delay2.read(64)*0.5,689)*(dsource==0);
ms1=lira_ramp(pow(2,time1/127*12)*1.45125,23.22)+(self1+dlfo)*lira_ramp(pow(dmod1/127,2)*10,23.22);
ms2=lira_ramp(pow(2,time2/127*12)*1.45125,23.22)+(self2+dlfo)*lira_ramp(pow(dmod2/127,2)*10,23.22);
hpf_4_a = clamp(1 - 6.28318530718 * (1) / samplerate, 0, 1); hpf_4_input = delay1.read(clamp(ms1*samplerate/1000,64,1048575),interp="cubic"); hpf_4_out = (1+hpf_4_a)*0.5*(hpf_4_input-hpf_4_x)+hpf_4_a*hpf_4_y; hpf_4_x=hpf_4_input; hpf_4_y=hpf_4_out;
d1=lira_dynamics(lira_lp(hpf_4_out,4000));
hpf_5_a = clamp(1 - 6.28318530718 * (1) / samplerate, 0, 1); hpf_5_input = delay2.read(clamp(ms2*samplerate/1000,64,1048575),interp="cubic"); hpf_5_out = (1+hpf_5_a)*0.5*(hpf_5_input-hpf_5_x)+hpf_5_a*hpf_5_y; hpf_5_x=hpf_5_input; hpf_5_y=hpf_5_out;
d2=lira_dynamics(lira_lp(hpf_5_out,4000));
n=noise()*0.001;
delay1.write(dry+n+d1*fb);delay2.write(dry+n+d2*fb);
wet=lira_sat((d1+d2)*0.5/max(fb,1.5));
dm=lira_ramp(dmix/127,23.22); mixed=dry*(1-dm)+wet*dm;
dg=lira_ramp(pow(10,(pow(3,1+2*drive/127)+3)/20),23.22);
hpf_6_a = clamp(1 - 6.28318530718 * (20) / samplerate, 0, 1); hpf_6_input = mixed*dg; hpf_6_out = (1+hpf_6_a)*0.5*(hpf_6_input-hpf_6_x)+hpf_6_a*hpf_6_y; hpf_6_x=hpf_6_input; hpf_6_y=hpf_6_out;
dist=lira_sat(hpf_6_out);
hpf_7_a = clamp(1 - 6.28318530718 * (10) / samplerate, 0, 1); hpf_7_input = dist+pow(dist,31)*0.25; hpf_7_out = (1+hpf_7_a)*0.5*(hpf_7_input-hpf_7_x)+hpf_7_a*hpf_7_y; hpf_7_x=hpf_7_input; hpf_7_y=hpf_7_out;
dist=hpf_7_out/clamp(dg,1,4)+mixed*0.1;
mixd=lira_ramp(distmix/127,23.22);
master=lira_sat(mixed*(1-mixd)+dist*mixd);
hpf_8_a = clamp(1 - 6.28318530718 * (3) / samplerate, 0, 1); hpf_8_input = master; hpf_8_out = (1+hpf_8_a)*0.5*(hpf_8_input-hpf_8_x)+hpf_8_a*hpf_8_y; hpf_8_x=hpf_8_input; hpf_8_y=hpf_8_out;
totaldelay.write(hpf_8_out);
out1=master*lira_ramp(pow(volume/127,2),23.22);
out2=out1;
