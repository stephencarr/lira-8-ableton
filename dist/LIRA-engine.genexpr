v6=lira_voice(fq6*pow(2,lira_ramp(bend6,5)/12)*(1+vib3*0.005)*(1+src3*md3),clamp(sh3+lira_ramp(press6,10)*0.6,0,1),max(gate6,voiceon6),lira_ramp(pow(hold2/127,2),23.22),fast3,0.53125+vib3*0.025);
raw7=mtof(33+tune7/127*93.24)*(0.01+1.99*pitch2/127);
fq7=lira_ramp(quantize>0?mtof(floor(ftom(raw7)+0.5)):raw7,23.22);
v7=lira_voice(fq7*pow(2,lira_ramp(bend7,5)/12)*(1+vib4*0.005)*(1+src4*md4),clamp(sh4+lira_ramp(press7,10)*0.6,0,1),max(gate7,voiceon7),lira_ramp(pow(hold2/127,2),23.22),fast4,0.53125+vib4*0.025);
raw8=mtof(33+tune8/127*98.22)*(0.01+1.99*pitch2/127);
