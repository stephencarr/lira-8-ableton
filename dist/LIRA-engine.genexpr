raw5=mtof(20+tune5/127*96.54)*(0.01+1.99*pitch2/127);
fq5=lira_ramp(quantize>0?mtof(floor(ftom(raw5)+0.5)):raw5,23.22);
v5=lira_voice(fq5*pow(2,lira_ramp(bend5,5)/12)*(1+vib3*0.005)*(1+src3*md3),clamp(sh3+lira_ramp(press5,10)*0.6,0,1),max(gate5,voiceon5),lira_ramp(pow(hold2/127,2),23.22),fast3,0.53125+vib3*0.025);
raw6=mtof(20+tune6/127*96.54)*(0.01+1.99*pitch2/127);
