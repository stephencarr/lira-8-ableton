pair_state1=pair1.read(63);pair_state2=pair2.read(63);pair_state3=pair3.read(63);pair_state4=pair4.read(63);total_state=totaldelay.read(63);
src1=((routing>0?0.001:1)*p2+(routing>0?1:0.001)*p4)*(source1==0?1:0.001)+(lmod*(totalfb>0?0.001:1)+tf*(totalfb>0?1:0.001))*(source1==2?1:0.001);
md1=lira_ramp(pow(mod1/127,4)*2,23.22); sh1=lira_ramp(pow(sharp1/127,2),23.22);
