v2=lira_voice(fq2*pow(2,lira_ramp(bend2,5)/12)*(1+vib1*0.005)*(1+src1*md1),clamp(sh1+lira_ramp(press2,10)*0.6,0,1),max(gate2,voiceon2),lira_ramp(pow(hold1/127,2),23.22),fast1,0.53125+vib1*0.025);
raw3=mtof(7+tune3/127*102)*(0.01+1.99*pitch1/127);
fq3=lira_ramp(quantize>0?mtof(floor(ftom(raw3)+0.5)):raw3,23.22);
v3=lira_voice(fq3*pow(2,lira_ramp(bend3,5)/12)*(1+vib2*0.005)*(1+src2*md2),clamp(sh2+lira_ramp(press3,10)*0.6,0,1),max(gate3,voiceon3),lira_ramp(pow(hold1/127,2),23.22),fast2,0.53125+vib2*0.025);
raw4=mtof(9+tune4/127*98)*(0.01+1.99*pitch1/127);
