        "box": {
          "id": "expressin",
          "maxclass": "newobj",
          "patching_rect": [
            20,
            800,
            150,
            22
          ],
          "numinlets": 0,
          "numoutlets": 1,
          "text": "midiin"
        }
      },
      {
        "box": {
          "id": "expressparse",
          "maxclass": "newobj",
          "patching_rect": [
            20,
            800,
            150,
            22
          ],
          "numinlets": 1,
          "numoutlets": 10,
          "text": "mpeparse @hires 1"
        }
      },
      {
        "box": {
          "id": "expression",
          "maxclass": "v8.codebox",
          "patching_rect": [
            20,
            800,
            150,
            22
          ],
          "code": "// Native MPE from midiin -> mpeparse. Expression never changes saved tuning.\ninlets=1;outlets=1;\nvar zone=0, first=0, voice=-1, notes={}, serial=0;\nfunction zoneindex(v){zone=Number(v);}\nfunction zonefirst(v){first=Number(v);}\nfunction mpevoice(v){voice=Number(v);}\nfunction key(){return first+':'+zone+':'+voice;}\nfunction record(){var k=key();if(!notes[k])notes[k]={target:-1,pitch:-1,bend:0,pressure:0,order:0};return notes[k];}\nfunction emit(i){\n var chosen=null;\n for(var k in notes){var n=notes[k];if(n.target===i&&(!chosen||n.order>chosen.order))chosen=n;}\n outlet(0,'gate'+(i+1),chosen?1:0);\n outlet(0,'bend'+(i+1),chosen?chosen.bend:0);\n outlet(0,'press'+(i+1),chosen?chosen.pressure:0);\n}\nfunction note(p,v){\n p=Number(p);v=Number(v);\n // Unvoiced conventional MIDI uses pitch as identity, allowing chords.\n var n=voice<0?(notes['plain:'+p]||(notes['plain:'+p]={target:-1,pitch:p,bend:0,pressure:0,order:0})):record();\n var old=n.target;\n if(v>0){n.pitch=p;n.target=p>=36&&p<=43?p-36:-1;n.order=++serial;}\n else if(n.pitch===p){n.target=-1;n.bend=0;n.pressure=0;}\n if(old>=0)emit(old);\n if(n.target>=0)emit(n.target);\n}\nfunction bend(v){} // Horizontal movement no longer affects tuning.\nfunction applypressure(n,v){n.pressure=Math.max(0,Math.min(127,Number(v)||0))/127;n.bend=n.pressure*2;}\nfunction pressure(v){if(voice<0)return;var n=record();applypressure(n,v);if(n.target>=0)emit(n.target);}\nfunction polypressure(v,p){for(var k in notes){var n=notes[k];if(n.target>=0&&n.pitch===Number(p)){applypressure(n,v);emit(n.target);}}}\nfunction reset(){notes={};for(var i=0;i<8;i++)emit(i);}\nfunction notifydeleted(){reset();}\n",
          "filename": "none",
          "numinlets": 1,
          "numoutlets": 1,
          "outlettype": [
            ""
          ],
          "saved_object_attributes": {
            "parameter_enable": 0
          }
        }
      },
